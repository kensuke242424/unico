#!/bin/bash

# prepare-commit-msg フック
# ブランチ名から #XX を抽出し、コミットメッセージの先頭に自動追加

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

# merge, squash, commit --amend 等の場合はスキップ
# message (git commit -m) の場合は処理を継続
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ] || [ "$COMMIT_SOURCE" = "commit" ]; then
    exit 0
fi

# 現在のブランチ名を取得
BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ -z "$BRANCH_NAME" ]; then
    exit 0
fi

# ブランチ名から #XX を抽出（例: feature/#62-fix-bug → #62）
ISSUE_NUMBER=$(echo "$BRANCH_NAME" | grep -oE '#[0-9]+' | head -n 1)

if [ -z "$ISSUE_NUMBER" ]; then
    # #XX が見つからない場合、何もしない
    exit 0
fi

# 現在のコミットメッセージを取得
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# すでに [#XX] が含まれているかチェック
if echo "$COMMIT_MSG" | grep -qE '^\[#[0-9]+\]'; then
    # すでに含まれている場合、何もしない
    exit 0
fi

# [#XX] をコミットメッセージの先頭に追加
echo "[$ISSUE_NUMBER] $COMMIT_MSG" > "$COMMIT_MSG_FILE"

exit 0
